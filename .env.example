# Copy to .env and adjust. Every variable is optional.

# Inputs
# COMPCOPILOT_EVIDENCE_DIR=configs/evidence
# COMPCOPILOT_POLICIES_DIR=configs/policies
# COMPCOPILOT_EXCEPTIONS_FILE=configs/exceptions.yaml
# JSON list of frameworks in scope: soc2, iso27001, nist_csf, hipaa, pci_dss, gdpr
COMPCOPILOT_FRAMEWORKS=["soc2","iso27001"]
# COMPCOPILOT_AS_OF=2026-09-19

# Optional model-written summaries
# llm_provider: none | openai | anthropic. The model only sees aggregate counts and readiness figures.
COMPCOPILOT_LLM_PROVIDER=none
# COMPCOPILOT_OPENAI_API_KEY=
COMPCOPILOT_OPENAI_BASE_URL=https://api.openai.com/v1
COMPCOPILOT_OPENAI_CHAT_MODEL=gpt-4o-mini
# COMPCOPILOT_ANTHROPIC_API_KEY=
COMPCOPILOT_ANTHROPIC_BASE_URL=https://api.anthropic.com
COMPCOPILOT_ANTHROPIC_MODEL=claude-sonnet-5
COMPCOPILOT_ANTHROPIC_MAX_TOKENS=500

# HTTP and logging
COMPCOPILOT_HTTP_TIMEOUT_SECONDS=30
COMPCOPILOT_RETRY_ATTEMPTS=3
COMPCOPILOT_RETRY_MIN_WAIT=0.5
COMPCOPILOT_RETRY_MAX_WAIT=8
COMPCOPILOT_LOG_LEVEL=WARNING
COMPCOPILOT_LOG_JSON=true
